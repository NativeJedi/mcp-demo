# LLM provider: openai | anthropic (default: openai)
LLM_PROVIDER=openai
# Optional. Defaults: openai -> gpt-5.5, anthropic -> claude-sonnet-5-5
LLM_MODEL=
# Only the selected provider's key is required
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults: node packages/server/dist/index.js (run from the repo root)
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=
